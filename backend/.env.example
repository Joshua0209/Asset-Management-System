APP_NAME=Asset Management System API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/asset_management
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# JWT — generate a 32+ byte random secret for production (e.g., `python -c 'import secrets; print(secrets.token_urlsafe(48))'`)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=720

# Bootstrap manager — seeded idempotently so the first manager always exists.
# Change the password before exposing the system outside the team.
BOOTSTRAP_MANAGER_EMAIL=admin@example.com
BOOTSTRAP_MANAGER_PASSWORD=ChangeMe123
BOOTSTRAP_MANAGER_NAME=Bootstrap Manager
BOOTSTRAP_MANAGER_DEPARTMENT=資產管理部
BOOTSTRAP_MANAGER_LOCATION=台北南港總部 8F

# Local repair-image storage path; override per environment.
REPAIR_UPLOAD_DIR=uploads/repair-requests

# Rate limiting — in-memory slowapi (per-process). Phase 2 stays at ~4 QPS
# so per-worker counters are acceptable; revisit when Phase 3 lands Redis.
# Set RATE_LIMIT_ENABLED=false in CI / pytest to skip limiting entirely.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTHENTICATED=100/minute
RATE_LIMIT_ANONYMOUS=30/minute
RATE_LIMIT_IMAGES=300/minute

# CORS — JSON arrays. Defaults reflect this API's actual surface
# (no DELETE routes, no If-Match). Add origins per environment for AWS rollout.
CORS_ALLOWED_METHODS=["GET","POST","PATCH","OPTIONS"]
CORS_ALLOWED_HEADERS=["Authorization","Content-Type"]

# Observability (W6 Phase 3 of the prod migration plan) — OTLP-native,
# push direct to Grafana Cloud from both local dev and production ECS.
# All opt-in: with OTEL_ENABLED=false the backend boots with zero
# outbound telemetry, which is the right default for credential-less
# local dev.
#
# Developers who want full local correlation (Tempo + Prom + Loki +
# Pyroscope) wire their own Grafana Cloud credentials below and flip
# OTEL_ENABLED=true. Production sets all of these via the
# `ams-grafana-cloud` Secrets Manager entry on the ECS task definition
# (see docs/plans/observability-prod-migration-plan.md § Phase 4).
#
# OTEL_EXPORTER_OTLP_HEADERS uses the SDK's comma-separated key=value
# convention: `Authorization=Basic <base64(prom_instance_id:api_key)>`.
# PYROSCOPE_BASIC_AUTH_USERNAME is the per-stack Pyroscope instance id;
# PYROSCOPE_AUTH_TOKEN is the same Grafana Cloud API key as OTLP.
#
# ENVIRONMENT becomes a resource attribute on every signal so the six
# Grafana Cloud dashboards can filter local vs production with a single
# `$environment` template variable.
#
# LOG_FORMAT=json is the production default; LOG_FORMAT=text yields
# human-readable logs for interactive debug.
OTEL_ENABLED=false
OTEL_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instance_id:api_key>
PYROSCOPE_ENABLED=false
PYROSCOPE_SERVER=https://profiles-prod-<region>.grafana.net
PYROSCOPE_AUTH_TOKEN=<your-gc-api-key>
PYROSCOPE_BASIC_AUTH_USERNAME=<your-gc-pyroscope-instance-id>
ENVIRONMENT=local
LOG_FORMAT=json
# REPLICA_ID falls back to $HOSTNAME if unset (Docker / ECS provide this);
# override only when running multiple replicas outside container orchestration.
# REPLICA_ID=ams-backend-0
