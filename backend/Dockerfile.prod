# Production image for the FastAPI backend.
#
# Multi-stage:
#   1. builder — installs runtime deps (no [dev]) into a wheelhouse
#   2. final   — slim runtime, copies wheels + app, drops root, runs gunicorn
#
# This image is what gets pushed to ECR and run on ECS. The dev image
# (./Dockerfile) is bind-mount + uvicorn --reload and stays separate.

# ─── Stage 1: builder ──────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

# Build deps for any wheels that don't ship pre-compiled (cryptography, etc.).
# Pruned in the final stage — none of this goes to runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app ./app

# Install with the [prod] extra (gunicorn) but NOT [dev]. `--prefix=/install`
# stages everything under one tree we copy into the final image in one go.
RUN pip install --upgrade pip \
    && pip install --prefix=/install '.[prod]'

# ─── Stage 2: final ────────────────────────────────────────────────────────
FROM python:3.11-slim AS final

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Single worker is mandatory through Phase 2: slowapi's MemoryStorage is
    # per-process, so N workers would silently multiply every rate-limit cap
    # by N (see docs/system-design/08-deployment-operations.md §"API
    # Hardening: Rate Limiting" and the startup invariant in app/main.py).
    # Phase 2 scales by ECS task count (`desiredCount`), not gunicorn
    # workers. The runtime invariant hard-fails if WEB_CONCURRENCY or
    # GUNICORN_WORKERS gets bumped above 1 while rate limiting is on.
    WEB_CONCURRENCY=1 \
    GUNICORN_TIMEOUT=30 \
    # Trust gate for X-Forwarded-For rewriting. Loopback is a safe default
    # for local prod-image runs (matches uvicorn's own default behaviour);
    # ECS task definitions MUST override this to the ALB-subnet VPC CIDR
    # (e.g. 10.0.0.0/16). See docs/system-design/08-deployment-operations.md
    # §"Behind the ALB: client-IP resolution" and the startup WARN in
    # app/main.py that flags this default when rate limiting is enabled.
    FORWARDED_ALLOW_IPS=127.0.0.1

WORKDIR /app

# curl stays out of the final image — ALB does HTTP probes directly. If a
# future debugging need calls for an in-container probe, prefer python -c.
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /var/lib/ams/uploads \
    && chown -R app:app /app /var/lib/ams

# Copy installed deps from the builder stage.
COPY --from=builder /install /usr/local
COPY --chown=app:app app ./app
# scripts/ is required at runtime so the `seed-database` CI job can override
# the container command to `python scripts/seed_demo_data.py` against the
# already-deployed image. The script is destructive and refuses to run
# without AMS_SEED_CONFIRM=1 (set as an env override only by the seed job),
# so a stray `ecs exec` from an operator cannot accidentally trigger it.
# Audit on change: if scripts/ ever gains anything else that touches prod
# state, gate it the same way or move it out of the prod image.
COPY --chown=app:app scripts ./scripts
COPY --chown=app:app alembic ./alembic
COPY --chown=app:app alembic.ini ./alembic.ini

USER app

EXPOSE 8000

# gunicorn supervises uvicorn workers; --graceful-timeout matches ALB drain
# defaults so in-flight requests finish before the container is killed.
CMD ["sh", "-c", "gunicorn app.main:app \
    --workers ${WEB_CONCURRENCY} \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --timeout ${GUNICORN_TIMEOUT} \
    --graceful-timeout 30 \
    --forwarded-allow-ips \"${FORWARDED_ALLOW_IPS}\" \
    --access-logfile - \
    --error-logfile -"]
