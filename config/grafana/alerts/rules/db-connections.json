{
  "rules": [
    {
      "uid": "ams-db-connections-warning",
      "title": "RDS connection count above 70% of class max",
      "ruleGroup": "warning",
      "folderUID": "ams-production",
      "orgID": 1,
      "condition": "C",
      "for": "5m",
      "noDataState": "NoData",
      "execErrState": "OK",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "cloudwatch",
          "relativeTimeRange": {"from": 600, "to": 0},
          "model": {
            "refId": "A",
            "namespace": "AWS/RDS",
            "metricName": "DatabaseConnections",
            "dimensions": {"DBInstanceIdentifier": "ams-database"},
            "statistic": "Average",
            "period": "60",
            "region": "ap-east-2"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {"from": 0, "to": 0},
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {"evaluator": {"type": "gt", "params": [42]}}
            ]
          }
        }
      ],
      "labels": {"severity": "warning", "service": "ams-db"},
      "annotations": {
        "summary": "RDS connections >70% of an assumed max_connections ≈ 60 (i.e. 42)",
        "description": "Connection count is {{ $values.A.Value }}. The threshold assumes max_connections ≈ 60; warning at 70% = 42. Recompute if the RDS instance class changes (see docs/system-design/08-deployment-operations.md)."
      },
      "notification_settings": {"receiver": "email-default"},
      "isPaused": false
    },
    {
      "uid": "ams-db-connections-critical",
      "title": "RDS connection count above 90% of class max",
      "ruleGroup": "critical",
      "folderUID": "ams-production",
      "orgID": 1,
      "condition": "C",
      "for": "2m",
      "noDataState": "NoData",
      "execErrState": "OK",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "cloudwatch",
          "relativeTimeRange": {"from": 600, "to": 0},
          "model": {
            "refId": "A",
            "namespace": "AWS/RDS",
            "metricName": "DatabaseConnections",
            "dimensions": {"DBInstanceIdentifier": "ams-database"},
            "statistic": "Average",
            "period": "60",
            "region": "ap-east-2"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {"from": 0, "to": 0},
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {"evaluator": {"type": "gt", "params": [54]}}
            ]
          }
        }
      ],
      "labels": {"severity": "critical", "service": "ams-db"},
      "annotations": {
        "summary": "RDS connections >90% of an assumed max_connections ≈ 60 (i.e. 54)",
        "description": "Connection count is {{ $values.A.Value }}. The threshold assumes max_connections ≈ 60; critical at 90% = 54. Scale DB or optimise queries; recompute if the RDS instance class changes (see docs/system-design/08-deployment-operations.md)."
      },
      "notification_settings": {"receiver": "email-default"},
      "isPaused": false
    }
  ]
}
