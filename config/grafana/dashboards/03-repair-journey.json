  "panels": [
    {
      "datasource": {"type": "datasource", "uid": "grafana"},
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "mode": "markdown",
        "content": "**Domain-specific view of the AMS repair workflow.** The metrics here come from two custom counters in `app/core/observability.py`: `ams_fsm_transitions_total{from,to,asset_kind}` (every successful state change) and `ams_optimistic_conflicts_total{endpoint,code}` (every 409 raised when two writers raced or a transition was illegal). Latency panels pivot on the FastAPI `handler` label so a route template (e.g. `/api/v1/repair-requests/{repair_request_id}/approve`) shows up once regardless of which id is in the URL.\n\nRate windows are deliberately asymmetric: stat panels use `[5m]` for a smoothed headline, timeseries panels use `[1m]` so a regression is visible within a refresh cycle. Don't normalise them — pick the window that matches the question."
      },
      "title": "Repair Journey",
      "type": "text"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 4},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(ams_fsm_transitions_total[5m]))", "legendFormat": "transitions/sec", "refId": "A"}],
      "title": "FSM Transitions /sec",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 4},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(ams_optimistic_conflicts_total[5m]))", "legendFormat": "conflicts/sec", "refId": "A"}],
      "title": "409 Conflicts /sec",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 4},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/repair-requests\", method=\"POST\"}[5m])) by (le))", "legendFormat": "submit p95", "refId": "A"}],
      "title": "Submit Repair p95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 4},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/auth/login\", method=\"POST\"}[5m])) by (le))", "legendFormat": "login p95", "refId": "A"}],
      "title": "Login p95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 6,
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (from, to) (rate(ams_fsm_transitions_total[1m]))", "legendFormat": "{{from}} → {{to}}", "refId": "A"}],
      "title": "FSM Transitions By (from → to)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "id": 7,
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (code) (rate(ams_optimistic_conflicts_total[1m]))", "legendFormat": "{{code}}", "refId": "A"}],
      "title": "409 Conflicts By Code",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 17},
      "id": 8,
      "options": {"legend": {"calcs": ["max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/auth/login\", method=\"POST\"}[5m])) by (le))", "legendFormat": "login", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/repair-requests\", method=\"POST\"}[5m])) by (le))", "legendFormat": "submit-repair", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/repair-requests/{repair_request_id}/approve\"}[5m])) by (le))", "legendFormat": "approve-repair", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/repair-requests/{repair_request_id}/reject\"}[5m])) by (le))", "legendFormat": "reject-repair", "refId": "G"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/repair-requests/{repair_request_id}/complete\"}[5m])) by (le))", "legendFormat": "complete-repair", "refId": "D"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/assets\", method=\"POST\"}[5m])) by (le))", "legendFormat": "register-asset", "refId": "E"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"backend\", handler=\"/api/v1/assets\", method=\"GET\"}[5m])) by (le))", "legendFormat": "search-assets", "refId": "F"}
      ],
      "title": "p95 Latency For Seven Critical Flows",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "id": 9,
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (to) (increase(ams_fsm_transitions_total{asset_kind=\"repair_request\"}[5m]))", "legendFormat": "→ {{to}}", "refId": "A"}],
      "title": "Repair-Request Transitions Into Each State (5m bucket)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "id": 10,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": true, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"datasource": {"type": "loki", "uid": "loki"}, "expr": "{service=\"backend\"} | json | path=~\"/api/v1/repair-requests.*\"", "refId": "A"}],
      "title": "Repair Request Logs (click trace_id → Tempo)",
      "type": "logs"
    }
  ],
