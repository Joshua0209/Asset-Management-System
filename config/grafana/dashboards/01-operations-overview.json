      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(http_requests_total{service=\"backend\", status=\"5xx\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"backend\"}[5m])), 0.001)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "Global Error Ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 3}]}}, "overrides": []},
