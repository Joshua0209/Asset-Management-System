# Repository-level environment file. Backend-specific values live in
# backend/.env; the variables below only affect the docker compose overlays.
#
# Copy to .env (git-ignored) and edit if your environment differs.

# Docker daemon root. The compose overlay bind-mounts ${DOCKER_ROOT_DIR}/containers
# into Alloy so it can read per-container log files, and ${DOCKER_ROOT_DIR}/ into
# cAdvisor for container stats. The Makefile auto-detects this via
# `docker info -f '{{.DockerRootDir}}'`; only override if that auto-detect picks
# the wrong path (rootless Docker, Lima, Colima, etc).
DOCKER_ROOT_DIR=/var/lib/docker

# CloudWatch reader credentials (Phase 6). Optional — if unset, the two
# CloudWatch panels on the Operations Overview dashboard render "No data" but
# the rest of Grafana works. See docs/system-design/08-deployment-operations.md
# for how the `ams-grafana-reader` IAM user is provisioned.
# CLOUDWATCH_ACCESS_KEY=
# CLOUDWATCH_SECRET_KEY=
