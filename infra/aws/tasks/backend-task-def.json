{
  "family": "ams-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/ams-ecs-task-execution",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/ams-backend-task",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "PLACEHOLDER_IMAGE",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "REPAIR_IMAGE_BACKEND", "value": "s3"},
        {"name": "REPAIR_S3_BUCKET", "value": "__REPAIR_S3_BUCKET__"},
        {"name": "FORWARDED_ALLOW_IPS", "value": "*"},
        {"name": "WEB_CONCURRENCY", "value": "1"},
        {"name": "BOOTSTRAP_MANAGER_EMAIL", "value": "__BOOTSTRAP_MANAGER_EMAIL__"},
        {"name": "ENVIRONMENT", "value": "production"},
        {"name": "OTEL_ENABLED", "value": "true"},
        {"name": "OTEL_ENDPOINT", "value": "__GC_OTLP_ENDPOINT__"},
        {"name": "OTEL_SEMCONV_STABILITY_OPT_IN", "value": "http"},
        {"name": "PYROSCOPE_ENABLED", "value": "true"},
        {"name": "PYROSCOPE_SERVER", "value": "__GC_PYROSCOPE_ENDPOINT__"}
      ],
      "secrets": [
        {"name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__DATABASE_URL_SECRET_NAME__:DATABASE_URL:AWSCURRENT:"},
        {"name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__APP_SECRET_NAME__:JWT_SECRET:AWSCURRENT:"},
        {"name": "BOOTSTRAP_MANAGER_PASSWORD", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__APP_SECRET_NAME__:BOOTSTRAP_MANAGER_PASSWORD:AWSCURRENT:"},
        {"name": "OTEL_EXPORTER_OTLP_HEADERS", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__GC_SECRET_NAME__:OTEL_EXPORTER_OTLP_HEADERS:AWSCURRENT:"},
        {"name": "PYROSCOPE_AUTH_TOKEN", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__GC_SECRET_NAME__:PYROSCOPE_AUTH_TOKEN:AWSCURRENT:"},
        {"name": "PYROSCOPE_BASIC_AUTH_USERNAME", "valueFrom": "arn:aws:secretsmanager:__REGION__:__ACCOUNT_ID__:secret:__GC_SECRET_NAME__:PYROSCOPE_BASIC_AUTH_USERNAME:AWSCURRENT:"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/ready',timeout=2).status==200 else 1)\" || exit 1"],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ams-backend",
          "awslogs-region": "__REGION__",
          "awslogs-stream-prefix": "backend",
          "awslogs-create-group": "true"
        }
      },
      "stopTimeout": 30
    }
  ]
}
