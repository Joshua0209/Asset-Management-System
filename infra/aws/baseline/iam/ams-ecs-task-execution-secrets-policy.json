{
    "RoleName": "ams-ecs-task-execution",
    "PolicyName": "ams-secrets-access",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "secretsmanager:GetSecretValue"
                ],
                "Resource": [
                    "arn:aws:secretsmanager:ap-east-2:__ACCOUNT_ID__:secret:rds!db-*",
                    "arn:aws:secretsmanager:ap-east-2:__ACCOUNT_ID__:secret:ams/prod/app-*",
                    "arn:aws:secretsmanager:ap-east-2:__ACCOUNT_ID__:secret:ams/prod/database_url-*"
                ]
            }
        ]
    }
}
