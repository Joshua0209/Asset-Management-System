{
    "RoleName": "ams-backend-task",
    "PolicyName": "ams-s3-access",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Effect": "Allow",
                "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:ListBucket"
                ],
                "Resource": [
                    "arn:aws:s3:::__REPAIR_S3_BUCKET__",
                    "arn:aws:s3:::__REPAIR_S3_BUCKET__/*"
                ]
            }
        ]
    }
}
