{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopedLogReads",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:StartQuery"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/ecs/ams-*:*"
    },
    {
      "Sid": "LogQueryControl",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:GetQueryResults",
        "logs:StopQuery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchMetricsRead",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "tag:GetResources",
        "rds:DescribeDBInstances",
        "ec2:DescribeRegions"
      ],
      "Resource": "*"
    }
  ]
}
