# Frontend build-time environment variables. Copy to .env.local for dev or
# pass via --build-arg in the production Dockerfile. Vite inlines every
# VITE_* value at build time, so the production image must be rebuilt to
# change any of these — there is no runtime opt-in.

# Base path the SPA's axios client targets. Defaults to /api/v1 which works
# when the frontend container sits behind the same ALB as the backend.
VITE_API_BASE_URL=/api/v1

# Observability (Phase 2 of docs/plans/observability-implementation-plan.md).
# When VITE_OTEL_ENABLED is "true", main.tsx initialises the browser OTLP
# tracer at startup. The expected production setup is browser-tracing OFF —
# the compose observability overlay (docker-compose.observability.yml) is
# the only environment where the browser is meant to push to Alloy directly.
# ECS prod builds leave these unset and emit no traces from the browser.
VITE_OTEL_ENABLED=false

# OTLP HTTP traces endpoint the browser exporter posts to. Only consulted
# when VITE_OTEL_ENABLED=true. Defaults to http://localhost:4318/v1/traces
# (Alloy on the compose overlay).
VITE_OTEL_ENDPOINT=http://localhost:4318/v1/traces

# Cross-origin trace context propagation is derived automatically from
# VITE_API_BASE_URL: if it is an absolute URL with a different origin from
# the page, that origin is added to OTel's propagateTraceHeaderCorsUrls so
# frontend fetch spans inject `traceparent` into backend calls. Same-origin
# / relative bases need no propagation list.
