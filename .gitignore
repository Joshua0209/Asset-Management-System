# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Secrets / env ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Python test / quality tools ───────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── Backend uploads (local-disk image storage) ───────────────────────────────
backend/uploads/
uploads/

# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/*.tsbuildinfo

# Stray node_modules at repo root — npm install run from the wrong cwd or
# tooling that resolves "node_modules" hopping up the tree can drop a
# cache here even though the real project lives under frontend/.
/node_modules/

# ── Playwright E2E ────────────────────────────────────────────────────────────
frontend/e2e/playwright-report/
frontend/e2e/test-results/
frontend/playwright-report/
frontend/test-results/

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/
